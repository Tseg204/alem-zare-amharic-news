# .gitignore — files Git must never save or upload.
# Each line is a pattern; a line starting with # is a comment.

# Secrets (Azure key) — NEVER commit
.env

# macOS / editor clutter
.DS_Store
__pycache__/
*.pyc

# Generated by the scripts — can always be re-created, and large
editions/*/cards/
editions/*/layers/
editions/*/audio/
editions/*/video/

# Music files: the licence allows use in our videos, not re-sharing the files.
# music/tracks.json + music/README.md (the list + licences) ARE saved.
music/*.mp3
music/*.wav

# Editor settings (personal)
.vscode/

# Animation (motion/): installed packages are re-created with `cd motion && npm ci`
motion/node_modules/
.hyperframes/
# Early animation experiments (not part of the pipeline)
prototypes/
